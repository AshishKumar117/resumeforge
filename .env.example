# ResumeForge environment variables
# Copy this file to `.env` and fill in real values. Everything marked OPTIONAL
# has a graceful local fallback so the app runs without it.

# --- Database (Prisma 7) -------------------------------------------------
# PostgreSQL (production + Vercel). Use a free Neon/Supabase instance or local Postgres.
DATABASE_URL="postgresql://user:pass@host:5432/resumeforge?schema=public"

# --- App ------------------------------------------------------------------
APP_URL="http://localhost:3000"
AUTH_SECRET="replace-with-a-long-random-string-min-32-chars"
AUTH_SESSION_TTL="30d"

# --- OAuth ----------------------------------------------------------------
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# GitHub: https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- AI (Anthropic Claude) ------------------------------------------------
# OPTIONAL — without a key, the app falls back to a deterministic local engine.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"

# --- Email (Resend) -------------------------------------------------------
# OPTIONAL — without a key, emails are logged to the console.
RESEND_API_KEY=""
EMAIL_FROM="ResumeForge <noreply@yourdomain.com>"

# --- Payments (Stripe) ----------------------------------------------------
# OPTIONAL — without keys, Pro gating is unlocked for development.
# Create a monthly and annual subscription price in Stripe and paste their IDs.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_MONTHLY=""
STRIPE_PRICE_ANNUAL=""

# --- Storage (Cloudflare R2 / S3) ----------------------------------------
# OPTIONAL — falls back to local filesystem in ./public/uploads
STORAGE_DRIVER="local" # local | s3
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""

# --- Monitoring / Analytics ----------------------------------------------
# OPTIONAL
SENTRY_DSN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""
